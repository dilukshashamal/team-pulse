# PostgreSQL Database Configuration
POSTGRES_USER=teampulse
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=teampulse_db
DATABASE_URL="postgresql://teampulse:your_secure_password_here@localhost:5432/teampulse_db?schema=public"

# Auth.js / NextAuth Secret 
# Example command: openssl rand -base64 32
AUTH_SECRET="your_high_entropy_secret_here"
AUTH_TRUST_HOST=true

# Canonical URL of the application
NEXTAUTH_URL="http://localhost:3000"